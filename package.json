{
  "name": "postdeck",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:up": "tsx --env-file-if-exists=.env.local scripts/migrate.ts up",
    "db:down": "tsx --env-file-if-exists=.env.local scripts/migrate.ts down",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/migrate.ts reset",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "test:secrets": "tsx scripts/check-no-secrets.ts",
    "gauntlet": "tsx scripts/gauntlet.ts",
    "publish:due": "tsx --env-file-if-exists=.env.local scripts/publish-due.ts",
    "verify": "APP_ORIGIN=${APP_ORIGIN:-http://127.0.0.1:3000} npm run build && npm run typecheck && npm run test && npm run test:secrets",
    "seed:admin": "tsx --env-file-if-exists=.env.local scripts/seed-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "otplib": "13.4.1",
    "pg": "8.23.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
