# PostDeck environment. Copy to .env.local and fill in real values.
# PLACEHOLDERS ONLY — never commit real credentials to this file.

# --- Public (safe to ship in the browser bundle) -----------------------------
# Both of these are designed to be public; row level security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Server only (NEVER prefix these with NEXT_PUBLIC_) ----------------------
# The service role key bypasses row level security. It is read only by
# lib/supabase/admin.ts, which is marked server-only so it cannot be bundled.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection used by the migration runner (scripts/migrate.ts).
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Used by scripts/seed-admin.ts when creating the first administrator locally.
SUPABASE_URL=https://your-project-ref.supabase.co
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Phase 2: the Meta (Facebook / Instagram) connector ---------------------
# Register an app at developers.facebook.com, add "Facebook Login for Business",
# and set its redirect URI to <APP_ORIGIN>/api/connectors/facebook/callback (and
# /instagram/callback). The secret is server-only and never reaches the browser.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# --- Phase 5: the writing assistant -----------------------------------------
# An Anthropic API key, from console.anthropic.com. Server-only: it is read by
# lib/assistant/claude.ts, which is marked server-only, and is canaried by
# `npm run test:secrets`. Leave it unset and the assistant simply does not appear
# in the composer -- everything else works exactly as before.
ANTHROPIC_API_KEY=your-anthropic-api-key

# The exact origin(s) this app is served from, comma separated. Required in
# production: CSRF and Next.js's own Server Action origin check both compare
# against this list rather than against request headers, which a client controls.
APP_ORIGIN=https://your-app.example.com

# Signs the CSRF token so a planted cookie cannot be passed off as one we issued.
# Generate with: openssl rand -base64 48
CSRF_SIGNING_SECRET=replace-with-at-least-32-random-characters

# How many proxies sit in front of this app. The audit log reads the client address
# that many entries from the END of X-Forwarded-For, because an appending proxy
# writes `<what the client claimed>, <what the proxy saw>` -- so counting from the
# front records a value the client chose. Set it wrong and the recorded address is
# wrong, silently.
TRUSTED_PROXY_COUNT=1
