# PostDeck environment. Copy to .env.local and fill in real values.
# PLACEHOLDERS ONLY — never commit real credentials to this file.

# --- Public (safe to ship in the browser bundle) -----------------------------
# Both of these are designed to be public; row level security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Server only (NEVER prefix these with NEXT_PUBLIC_) ----------------------
# The service role key bypasses row level security. It is read only by
# lib/supabase/admin.ts, which is marked server-only so it cannot be bundled.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection used by the migration runner (scripts/migrate.ts).
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Used by scripts/seed-admin.ts when creating the first administrator locally.
SUPABASE_URL=https://your-project-ref.supabase.co
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
